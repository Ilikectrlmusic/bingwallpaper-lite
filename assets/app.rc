#include <windows.h>
#ifndef BWL_WORKER
1 ICON "app.ico"
2 ICON "github.ico"
#endif
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Bing Wallpaper Lite contributors\0"
#ifdef BWL_WORKER
            VALUE "FileDescription", "Bing Wallpaper Worker\0"
#else
            VALUE "FileDescription", "Bing Wallpaper\0"
#endif
            VALUE "FileVersion", "1.0.0\0"
            VALUE "ProductName", "Bing Wallpaper\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
